{
  "name": "marginalia",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first research, reading and annotation companion for reMarkable.",
  "license": "MIT",
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm --filter @marginalia/desktop dev",
    "build": "pnpm --filter @marginalia/desktop build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "cargo test --workspace",
    "test:safety": "cargo test -p marginalia-safety-suite -- --nocapture",
    "test:rust": "cargo test --workspace",
    "fmt": "cargo fmt --all",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:safety"
  }
}
